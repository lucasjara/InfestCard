<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="InfestCard.Views.Events.GuideModulePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#09090F">

    <Grid Padding="24">

        <VerticalStackLayout
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="16">

            <Label
                x:Name="ModuleTitleLabel"
                Text="Módulo"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalTextAlignment="Center"/>

            <Label
                Text="CONTENIDO PRÓXIMAMENTE"
                FontSize="12"
                CharacterSpacing="2"
                TextColor="#C084FC"
                HorizontalTextAlignment="Center"/>

            <Label
                Text="Estamos preparando esta sección de la guía INFEST."
                FontSize="14"
                TextColor="#A1A1AA"
                HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>

    </Grid>

</ContentPage>
