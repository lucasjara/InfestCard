<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:InfestCard.ViewModels"
             xmlns:models="clr-namespace:InfestCard.Models"
             xmlns:converters="clr-namespace:InfestCard.Converters"
             xmlns:components="clr-namespace:InfestCard.Views.Components"
             x:Class="InfestCard.Views.CollectionPage"
             x:DataType="vm:CollectionViewModel"
             Title="Colección"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundColor}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CardNameFontSizeConverter
                x:Key="CardNameFontSizeConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="4">
                <Label
                    Text="MI COLECCIÓN"
                    Style="{StaticResource BrandTitle}"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label
                    Text="Tus cartas INFESTCard"
                    Style="{StaticResource SecondaryText}" />
            </VerticalStackLayout>
            <Button
                Grid.Column="1"
                Text="Escanear"
                Command="{Binding NavigateToScannerCommand}"
                VerticalOptions="Center" />
        </Grid>

        <CollectionView
            x:Name="CardsView"
            Grid.Row="1"
            ItemsSource="{Binding Cards}"
            SelectionMode="Single"
            SelectionChanged="OnCardSelected">
            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    Orientation="Vertical"
                    Span="2"
                    HorizontalItemSpacing="12"
                    VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <components:EmptyCollectionView />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Card">
                    <Border Style="{StaticResource NeonCard}" HeightRequest="220">
                        <VerticalStackLayout Spacing="8">
                            <Image
                                Source="{Binding LocalImagePath, FallbackValue=card_placeholder.svg, TargetNullValue=card_placeholder.svg}"
                                HeightRequest="100"
                                Aspect="AspectFit" />
                            <Label
                Text="{Binding Name}"
                Style="{StaticResource BodyText}"
                FontSize="{Binding Name, Converter={StaticResource CardNameFontSizeConverter}}"
                LineBreakMode="TailTruncation"
                MaxLines="2"
                HorizontalTextAlignment="Center" />
                            <Label HorizontalTextAlignment="Center" Text="{Binding Quantity, StringFormat='Cantidad: {0}'}" Style="{StaticResource SecondaryText}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
