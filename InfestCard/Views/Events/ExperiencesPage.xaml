<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InfestCard.Views.Events.ExperiencesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:InfestCard.ViewModels.Events"
    x:DataType="vm:ExperiencesViewModel"
    BackgroundColor="#09090F">

    <Grid
        Padding="18,16"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="18">

        <!-- HEADER -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="4">

            <Label
                Text="EXPERIENCIAS"
                FontSize="11"
                CharacterSpacing="3"
                FontAttributes="Bold"
                TextColor="#A855F7"/>

            <Label
                Text="Vive la experiencia"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="White"/>

            <Label
                Text="Actividades interactivas y zones especiales."
                FontSize="13"
                TextColor="#A1A1AA"/>

        </VerticalStackLayout>
        <!-- SEARCH AND FILTER -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="12">
            <Border
                BackgroundColor="#191923"
                Stroke="#3B3154"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="12,0"
                HeightRequest="52">

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Label
                        Text="⚙"
                        FontSize="18"
                        TextColor="#C084FC"
                        VerticalOptions="Center"/>
                    <Picker
                        Grid.Column="1"
                        Title="Filtrar por categoría"
                        TitleColor="#A1A1AA"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}"
                        FontSize="14"
                        HeightRequest="48"
                        VerticalOptions="Center"/>
                    <Label
                        Grid.Column="2"
                        Text=""
                        FontSize="20"
                        TextColor="#C084FC"
                        VerticalOptions="Center"/>
                </Grid>
            </Border>
        </VerticalStackLayout>
        <!-- EXPERIENCES LIST -->
        <Grid Grid.Row="2">
            <CollectionView
                ItemsSource="{Binding Items}"
                IsVisible="{Binding HasResults}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout
                        Orientation="Vertical"
                        ItemSpacing="12"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border
                            BackgroundColor="#171721"
                            Stroke="#343044"
                            StrokeThickness="1"
                            Padding="15"
                            StrokeShape="RoundRectangle 16">

                            <Grid
                                ColumnDefinitions="64,*"
                                ColumnSpacing="14">

                                <!-- ICON -->
                                <Border
                                    Grid.Column="0"
                                    WidthRequest="64"
                                    HeightRequest="64"
                                    BackgroundColor="#29183D"
                                    Stroke="#7134B5"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Icon}"
                                        FontSize="30"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                                </Border>
                                <!-- INFORMATION -->
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="5"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding Name}"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="White"/>
                                    <Label
                                        Text="{Binding Category}"
                                        FontSize="11"
                                        TextColor="#C084FC"/>
                                    <Label
                                        Text="{Binding Description}"
                                        FontSize="12"
                                        TextColor="#A1A1AA"
                                        MaxLines="2"/>
                                    <Grid
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="5">
                                        <Label
                                            Text="⌖"
                                            FontSize="13"
                                            TextColor="#C084FC"/>
                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding Location}"
                                            FontSize="11"
                                            TextColor="#C084FC"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <!-- EMPTY STATE -->
            <VerticalStackLayout
                IsVisible="{Binding HasNoResults}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="10">
                <Label
                    Text="⌕"
                    FontSize="48"
                    TextColor="#A855F7"
                    HorizontalTextAlignment="Center"/>
                <Label
                    Text="No encontramos experiencias"
                    FontSize="17"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center"/>
                <Label
                    Text="Prueba con otro nombre o categoría."
                    FontSize="12"
                    TextColor="#A1A1AA"
                    HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>