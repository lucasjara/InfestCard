<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:InfestCard.ViewModels"
             x:Class="InfestCard.MainPage"
             x:DataType="vm:MainViewModel"
             Title="INFESTCard"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid Padding="24" RowDefinitions="Auto,*,Auto" RowSpacing="24">
        <Label
            Grid.Row="0"
            Text="INFESTCARD"
            Style="{StaticResource BrandTitle}"
            SemanticProperties.HeadingLevel="Level1" />

        <Border
            Grid.Row="1"
            Style="{StaticResource NeonCard}">
            <VerticalStackLayout Spacing="16" VerticalOptions="Center">
                <Label
                    Text="{Binding Title}"
                    Style="{StaticResource PageTitle}"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="{Binding Subtitle}"
                    Style="{StaticResource BodyText}"
                    HorizontalTextAlignment="Center" />

                <BoxView Style="{StaticResource AccentDivider}" />

                <Label
                    Text="{Binding InitializationMessage}"
                    Style="{StaticResource SecondaryText}"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>

        <Label
            Grid.Row="2"
            Text="Descubre, colecciona y conserva tus cartas."
            Style="{StaticResource SecondaryText}"
            HorizontalTextAlignment="Center" />
    </Grid>

</ContentPage>
