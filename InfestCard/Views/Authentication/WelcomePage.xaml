<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InfestCard.Views.Authentication.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#10111B">

    <Grid Padding="28"
          RowDefinitions="*,Auto"
          RowSpacing="24">

        <!-- Main content -->
        <VerticalStackLayout
            Grid.Row="0"
            VerticalOptions="Center"
            HorizontalOptions="Fill"
            Spacing="22">

            <!-- Logo / Brand -->
            <VerticalStackLayout
                HorizontalOptions="Center"
                Spacing="12">

                <Border
                    WidthRequest="250"
                    HeightRequest="250"
                    Stroke="#763BFF"
                    StrokeThickness="1.5"
                    BackgroundColor="#1D1930"
                    StrokeShape="RoundRectangle 28">

                    <Image Source="logo.png"/>
                </Border>
                <Label
                    Text="Tu colección. Tu experiencia.&#10;Tu universo gamer."
                    FontSize="15"
                    TextColor="#A5A5B5"
                    HorizontalTextAlignment="Center"
                    LineHeight="1.4"/>
            </VerticalStackLayout>

            <BoxView
                HeightRequest="1"
                BackgroundColor="#292A3A"
                Margin="0,12"/>

            <!-- Welcome message -->
            <VerticalStackLayout Spacing="8">
                <Label
                    Text="¡Bienvenido!"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center"/>

                <Label
                    Text="Inicia sesión para disfrutar de una experiencia personalizada o continúa explorando tu colección."
                    FontSize="14"
                    TextColor="#A5A5B5"
                    HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- Google Login -->
            <Border
    BackgroundColor="White"
    Stroke="Transparent"
    HeightRequest="54"
    Padding="16,0"
    StrokeShape="RoundRectangle 14">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnGoogleLoginClicked"/>
                </Border.GestureRecognizers>

                <HorizontalStackLayout
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Spacing="10">

                    <Border
            WidthRequest="30"
            HeightRequest="30"
            Padding="4"
            Stroke="#DADADA"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 8"
            VerticalOptions="Center">

                        <Image
                Source="google_icon.png"
                Aspect="AspectFit"/>
                    </Border>

                    <Label
            Text="Continuar con Google"
            FontSize="16"
            FontAttributes="Bold"
            TextColor="#171717"
            VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>

            <!-- Guest access -->
            <Button
                x:Name="GuestButton"
                Text="Continuar sin iniciar sesión"
                FontSize="15"
                FontAttributes="Bold"
                TextColor="White"
                BackgroundColor="#29243D"
                BorderColor="#763BFF"
                BorderWidth="1"
                CornerRadius="14"
                HeightRequest="54"
                Clicked="OnGuestClicked"/>

            <Label
                Text="Podrás acceder a tus cartas sin necesidad de una cuenta."
                FontSize="12"
                TextColor="#77788C"
                HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>

        <!-- Footer -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="5"
            HorizontalOptions="Center">

            <Label
                Text="INFEST CHILE"
                FontSize="11"
                CharacterSpacing="3"
                FontAttributes="Bold"
                TextColor="#77788C"
                HorizontalTextAlignment="Center"/>

            <Label
                Text="© INFESTCard"
                FontSize="11"
                TextColor="#55566A"
                HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>

    </Grid>
</ContentPage>