<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:InfestCard.ViewModels"
             xmlns:models="clr-namespace:InfestCard.Models"
             xmlns:converters="clr-namespace:InfestCard.Converters"
             xmlns:components="clr-namespace:InfestCard.Views.Components"
             x:Class="InfestCard.Views.CollectionPage"
             x:DataType="vm:CollectionViewModel"
             x:Name="RootPage"
             Title="Colección"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ContentPage.Resources>
        <ResourceDictionary>

            <converters:CardNameFontSizeConverter
                x:Key="CardNameFontSizeConverter" />

            <converters:CardCategoryBorderConverter
                x:Key="CardCategoryBorderConverter" />

        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="20"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="14">

        <!-- ENCABEZADO -->
        <Grid x:Name="HeaderView"
              Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12"
              Opacity="0"
              TranslationY="12">

            <VerticalStackLayout Spacing="4">

                <Label
                    Text="MI COLECCIÓN"
                    Style="{StaticResource BrandTitle}" />

                <Label
                    Text="Tus cartas INFESTCard"
                    Style="{StaticResource SecondaryText}" />

            </VerticalStackLayout>

            <!-- ESCÁNER -->
            <Button
                x:Name="ScannerButton"
                Grid.Column="1"
                Command="{Binding NavigateToScannerCommand}"
                ImageSource="qr_code.png"
                WidthRequest="42"
                HeightRequest="42"
                Padding="8"
                VerticalOptions="Center"
                Scale="0.85" />

        </Grid>

        <!-- FILTROS -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="8">

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">

                <!-- ABRIR SELECTOR -->
                <Border
                    BackgroundColor="#252536"
                    Stroke="#A855F7"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    HeightRequest="48">

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          Padding="12,0"
                          ColumnSpacing="10">

                        <Image
                            Source="filter_icon.png"
                            WidthRequest="20"
                            HeightRequest="20"
                            VerticalOptions="Center" />

                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Spacing="1">

                            <Label
                                Text="Filtrar cartas"
                                TextColor="White"
                                FontSize="13"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding SelectedTypeLabel}"
                                TextColor="#C084FC"
                                FontSize="10"
                                LineBreakMode="TailTruncation" />

                        </VerticalStackLayout>

                        <Image
                            Grid.Column="2"
                            Source="chevron_down.svg"
                            WidthRequest="16"
                            HeightRequest="16"
                            VerticalOptions="Center" />

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="OnOpenFiltersTapped" />
                        </Grid.GestureRecognizers>

                    </Grid>
                </Border>

                <!-- LIMPIAR -->
                <Button
                    Grid.Column="1"
                    Text=""
                    ImageSource="filter_all.png"
                    Command="{Binding ClearFiltersCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#C084FC"
                    FontSize="12"
                    Padding="8,0"
                    HeightRequest="48"
                    VerticalOptions="Center" />

            </Grid>

        </VerticalStackLayout>

        <!-- COLECCIÓN -->
        <CollectionView
            x:Name="CardsView"
            Grid.Row="2"
            ItemsSource="{Binding FilteredCards}"
            SelectionMode="Single"
            SelectionChanged="OnCardSelected">

            <CollectionView.ItemsLayout>

                <GridItemsLayout
                    Orientation="Vertical"
                    Span="2"
                    HorizontalItemSpacing="12"
                    VerticalItemSpacing="12" />

            </CollectionView.ItemsLayout>

            <!-- SIN RESULTADOS -->
            <CollectionView.EmptyView>
                <components:EmptyCollectionView />
            </CollectionView.EmptyView>

            <!-- CARTAS -->
            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:Card">

                    <Border
                        Stroke="{Binding Category, Converter={StaticResource CardCategoryBorderConverter}}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 12"
                        HeightRequest="210"
                        Opacity="0"
                        TranslationY="14"
                        Loaded="OnCardLoaded">

                        <VerticalStackLayout
                            VerticalOptions="Center"
                            Spacing="8">

                            <!-- IMAGEN -->
                            <Grid
                                WidthRequest="120"
                                HeightRequest="125"
                                HorizontalOptions="Center"
                                Padding="0,10,10,0">

                                <Border
                                    Stroke="{Binding Category, Converter={StaticResource CardCategoryBorderConverter}}"
                                    StrokeThickness="2"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="#151520"
                                    Padding="4">

                                    <Image
                                        Source="{Binding LocalImagePath, FallbackValue=card_placeholder.svg, TargetNullValue=card_placeholder.svg}"
                                        Aspect="AspectFit"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill" />

                                </Border>

                                <!-- CANTIDAD -->
                                <Border
                                    HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    Margin="0,-10,-8,0"
                                    BackgroundColor="#A855F7"
                                    Stroke="#FFFFFF"
                                    StrokeThickness="1.5"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="8,5"
                                    ZIndex="1">

                                    <Label
                                        Text="{Binding Quantity, StringFormat='×{0}'}"
                                        TextColor="White"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center" />

                                </Border>

                            </Grid>

                            <!-- NOMBRE -->
                            <Label
                                Text="{Binding Name}"
                                Style="{StaticResource BodyText}"
                                FontSize="{Binding Name, Converter={StaticResource CardNameFontSizeConverter}}"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
