<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:InfestCard.ViewModels"
             x:Class="InfestCard.Views.ScannerPage"
             x:DataType="vm:ScannerViewModel"
             Title="Escanear carta"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="20"
          RowSpacing="16">

        <!-- Encabezado -->
        <VerticalStackLayout x:Name="HeaderView"
                             Grid.Row="0"
                             Spacing="4"
                             Opacity="0"
                             TranslationY="-10">

            <Label Text="ESCANEAR CARTA"
                   Style="{StaticResource BrandTitle}"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="Lee el código QR de una carta INFESTCard"
                   Style="{StaticResource SecondaryText}" />
        </VerticalStackLayout>

        <!-- Cámara -->
        <Border Grid.Row="1"
                Style="{StaticResource NeonCard}"
                Padding="0">

            <Grid x:Name="ScannerContainer"
                  WidthRequest="320"
                  HeightRequest="320"
                  HorizontalOptions="Center"
                  VerticalOptions="Center" />

        </Border>

        <!-- Controles inferiores -->
        <VerticalStackLayout x:Name="ControlsView"
                             Grid.Row="2"
                             Spacing="8"
                             Opacity="0"
                             TranslationY="10">

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource AccentColor}" />

            <Label Text="ZOOM"
                   Style="{StaticResource SecondaryText}"
                   HorizontalTextAlignment="Center" />

            <Slider x:Name="ZoomSlider"
                    Minimum="0"
                    Maximum="1"
                    Value="0"
                    ValueChanged="OnZoomChanged" />

            <Button Text="SELECCIONAR DESDE GALERÍA"
                    ImageSource="gallery.png"
                    ContentLayout="Left,10"
                    Clicked="OnSelectImageClicked"
                    BackgroundColor="{StaticResource SurfaceColor}"
                    TextColor="{StaticResource AccentColor}"
                    BorderColor="#C026D3"
                    BorderWidth="1.5"
                    CornerRadius="12"
                    HeightRequest="48"
                    FontAttributes="Bold" />

            <Label Text="{Binding StatusMessage}"
                   Style="{StaticResource SecondaryText}"
                   HorizontalTextAlignment="Center" />

            <Label Text="{Binding DetectedCardName}"
                   Style="{StaticResource BodyText}"
                   HorizontalTextAlignment="Center" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource ErrorColor}"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

    </Grid>
</ContentPage>