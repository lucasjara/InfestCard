<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:InfestCard.ViewModels"
             xmlns:components="clr-namespace:InfestCard.Views.Components"
             x:Class="InfestCard.Views.CollectionPage"
             x:DataType="vm:CollectionViewModel"
             Title="Colección"
             BackgroundColor="{StaticResource BackgroundColor}">
    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="4">
                <Label
                    Text="MI COLECCIÓN"
                    Style="{StaticResource BrandTitle}"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label
                    Text="Tus cartas INFESTCard"
                    Style="{StaticResource SecondaryText}" />
            </VerticalStackLayout>
        </Grid>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Cards}"
            SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    Orientation="Vertical"
                    Span="2"
                    HorizontalItemSpacing="12"
                    VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <components:EmptyCollectionView />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource NeonCard}" HeightRequest="220">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Name}" Style="{StaticResource BodyText}" />
                            <Label Text="{Binding Quantity, StringFormat='Cantidad: {0}'}" Style="{StaticResource SecondaryText}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
