<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:InfestCard.ViewModels"
             x:Class="InfestCard.Views.CardDetailPage"
             x:DataType="vm:CardDetailViewModel"
             xmlns:converters="clr-namespace:InfestCard.Converters"
             Title="Detalle de carta"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundColor}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CardCategoryBorderConverter
            x:Key="CardCategoryBorderConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <Border
            BackgroundColor="{StaticResource SurfaceColor}"
            Stroke="{Binding Card.Category, Converter={StaticResource CardCategoryBorderConverter}}"
            StrokeThickness="2"
            StrokeShape="RoundRectangle 16"
            Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Image
                        Source="{Binding ImageSource}"
                        HeightRequest="260"
                        Aspect="AspectFit" />
                    <Label
                        Text="{Binding Card.Name}"
                        Style="{StaticResource PageTitle}"
                        HorizontalTextAlignment="Center"
                        SemanticProperties.HeadingLevel="Level1" />
                    <Label
                        Text="{Binding CategoryDisplayName}"
                        TextColor="{Binding Card.Category, Converter={StaticResource CardCategoryBorderConverter}}"
                        Style="{StaticResource BrandTitle}"
                        FontSize="16"
                        HorizontalTextAlignment="Center" />
                    <BoxView
                        HeightRequest="2"
                        WidthRequest="120"
                        HorizontalOptions="Center"
                        BackgroundColor="{Binding Card.Category, Converter={StaticResource CardCategoryBorderConverter}}" />
                    <Label
                        Text="{Binding Card.Description}"
                        Style="{StaticResource BodyText}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <!--<Label Text="ID" Style="{StaticResource SecondaryText}" />
                        <Label Grid.Column="1" Text="{Binding Card.Id}" Style="{StaticResource BodyText}" HorizontalTextAlignment="End" />
                        -->
                        <Label Grid.Row="1" Text="Cantidad" Style="{StaticResource SecondaryText}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Card.Quantity}" Style="{StaticResource BodyText}" HorizontalTextAlignment="End" />
                    </Grid>
                    <Label
                        Text="NIVEL"
                        Style="{StaticResource SecondaryText}"
                        HorizontalTextAlignment="Center" />
                    <Label
                        Text="{Binding LevelIndicators}"
                        TextColor="{StaticResource AccentColor}"
                        FontSize="20"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
